---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { PortfolioPage } from '../components/landing/PortfolioPage';

const title = "OpenOrbit | Portfolio";
const description = "Explore OpenOrbit's shipped systems: predictive SaaS, sports performance platforms, DeFi infrastructure, AI automation and predictive analytics.";
const keywords = [
  "OpenOrbit portfolio",
  "software development projects",
  "SaaS development",
  "sports technology",
  "DeFi infrastructure",
  "AI automation",
  "predictive analytics platform",
];
---

<Layout title={title} description={description} keywords={keywords}>
  <PortfolioPage client:load />
</Layout>
